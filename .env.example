# RetailPulse environment reference
# The Flask backend loads variables from backend/.env.
# Copy backend/.env.example to backend/.env for local development.

SECRET_KEY=replace_with_a_strong_secret_key

DB_HOST=localhost
DB_NAME=retailpulse
DB_USER=postgres
DB_PASSWORD=replace_with_postgres_password
DB_PORT=5432

FLASK_DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

SESSION_COOKIE_NAME=retailpulse_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_SECONDS=86400

GEMINI_API_KEY=replace_with_gemini_api_key
AI_DEBUG_LOGS=False

MAIL_USERNAME=replace_with_gmail_address
MAIL_PASSWORD=replace_with_gmail_app_password
FRONTEND_URL=http://localhost:5173

PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PSQL_PATH=C:\Program Files\PostgreSQL\16\bin\psql.exe
PG_MAINTENANCE_DB=postgres

DEMO_PASSWORD=replace_with_demo_password
